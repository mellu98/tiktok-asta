{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Device Control",
  "version": "0.2.0",
  "identifier": "com.mellu98.android-device-control",
  "build": {
    "frontendDist": "../dist/dashboard"
  },
  "app": {
    "windows": [
      {
        "title": "Android Device Control",
        "width": 1080,
        "height": 920,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": ["binaries/poc-server"],
    "resources": {
      "resources/tools/": "tools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
