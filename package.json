{
  "name": "tiktok-asta",
  "version": "0.1.0",
  "private": true,
  "description": "POC controllo dispositivi Android da macOS — ADB + scrcpy + dashboard locale",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "lint": "eslint .",
    "test": "vitest run",
    "measure:latency": "tsx scripts/measure-latency.ts",
    "test:packaged": "bash scripts/test-packaged.sh",
    "setup": "bash scripts/setup-macos.sh",
    "doctor": "bash scripts/doctor.sh",
    "uninstall": "bash scripts/uninstall.sh",
    "app:fetch-tools": "bash scripts/fetch-tools.sh",
    "app:build": "npm run build && bash scripts/fetch-tools.sh && tauri build",
    "app:build:fast": "npm run build && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tsx": "^4.20.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
